{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccgram.dev/protocol/v1/schemas/Message.json",
  "title": "Message",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "conversationId": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "agent",
        "system"
      ]
    },
    "time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "phase": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "Part.json"
      }
    }
  },
  "required": [
    "id",
    "revision",
    "conversationId",
    "role",
    "time",
    "complete",
    "parts"
  ],
  "additionalProperties": true
}
