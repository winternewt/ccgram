{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ccgram.dev/protocol/v1/schemas/Upload.json",
  "title": "Upload",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "mime": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "url",
    "name",
    "size",
    "mime"
  ]
}
